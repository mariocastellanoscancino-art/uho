// Reglas de seguridad de Firestore para el sistema de vacaciones
// Copia estas reglas en la consola de Firebase > Firestore Database > Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para usuarios autenticados
    match /users/{userId} {
      // Los usuarios pueden leer y escribir sus propios datos
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reglas para solicitudes de vacaciones
    match /solicitudes_vacaciones/{requestId} {
      // Los usuarios autenticados pueden leer todas las solicitudes
      allow read: if request.auth != null;
      
      // Solo el usuario propietario puede crear/editar su solicitud
      allow create, update: if request.auth != null && 
        request.auth.uid == resource.data.empleadoId;
      
      // Los supervisores pueden aprobar/rechazar (implementar lógica específica)
      allow update: if request.auth != null && 
        request.auth.uid in resource.data.supervisores;
    }
    
    // Reglas para empleados
    match /empleados/{employeeId} {
      // Los usuarios autenticados pueden leer datos de empleados
      allow read: if request.auth != null;
      
      // Solo administradores pueden modificar datos de empleados
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Colección de prueba - solo para testing (eliminar en producción)
    match /test_connection/{docId} {
      allow read, write: if request.auth != null;
    }
    
    // Reglas por defecto - denegar acceso no especificado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}